<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title !== siteTitle ? title + ' — ' + siteTitle : siteTitle %></title>
<meta name="description" content="A personal research observatory. Science, ideas and the world, gathered daily.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/periphery.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23fbfaf7'/><text y='74' x='50' text-anchor='middle' font-size='72' font-family='Georgia,serif' fill='%2314110f'>P</text></svg>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip" href="#main">Skip to the reading</a>

<header class="masthead">
  <div class="masthead__rule masthead__rule--top" aria-hidden="true"></div>
  <div class="masthead__inner">
    <p class="masthead__eyebrow"><%= fmt.long(new Date().toISOString()) %></p>
    <h1 class="masthead__title"><a href="/">PERIPHERY</a></h1>
    <p class="masthead__subtitle"><%= siteSubtitle %></p>
  </div>
  <nav class="nav" aria-label="Sections">
    <ul>
      <% (typeof nav !== 'undefined' ? nav : []).forEach(function (n) { %>
        <li><a href="<%= n.href %>" class="<%= (path === n.href || (n.href !== '/' && path.indexOf(n.href) === 0)) ? 'is-current' : '' %>"><%= n.label %><% if (n.href === '/research' && typeof savedCount !== 'undefined' && savedCount) { %> <span class="nav__count"><%= savedCount %></span><% } %></a></li>
      <% }) %>
      <% if (typeof staticMode === 'undefined' || !staticMode) { %>
        <li class="nav__end"><a href="/profile" class="<%= path === '/profile' ? 'is-current' : '' %>">Research profile</a></li>
      <% } else { %>
        <li class="nav__end"><a href="/about" class="<%= path === '/about' ? 'is-current' : '' %>">About</a></li>
      <% } %>
    </ul>
  </nav>
</header>

<main id="main">
