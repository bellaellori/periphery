# ---------------------------------------------------------------------------
# PERIPHERY — environment
# Copy to .env and run with:  node --env-file=.env src/server.js
# ---------------------------------------------------------------------------

# Where the site listens.
PORT=3000
NODE_ENV=production

# Where the database file lives. On a hosted platform this MUST point at a
# mounted persistent volume, or the library is lost on every deploy.
DATABASE_PATH=./data/periphery.db

# --- access -----------------------------------------------------------------
# Protects /admin. With no token set, the editorial desk is open — acceptable on
# a laptop, never on a public host.
ADMIN_TOKEN=

# Optional password on the whole site. Set it if PERIPHERY is on a public URL.
SITE_PASSWORD=

# A narrow credential for the scheduler: it can trigger the pipeline and
# nothing else. Set this instead of handing the admin token to a cron service.
CRON_SECRET=

# --- summarisation ----------------------------------------------------------
# With a key, editions are written by a model from the retrieved abstract, under
# a strict brief: no invention, uncertainty preserved, nulls where the source is
# silent. Without one, summaries are extracted from the abstract instead — plainer,
# but incapable of hallucinating. The site says which was used on every entry.
ANTHROPIC_API_KEY=
PERIPHERY_MODEL=claude-sonnet-4-5

# --- retrieval --------------------------------------------------------------
# Sent with every request. Several scholarly APIs ask for a contact address and
# rate-limit anonymous traffic harder.
PERIPHERY_USER_AGENT=PERIPHERY/1.0 (personal research observatory; you@example.com)
FETCH_TIMEOUT_MS=20000

# Optional. Raises the PubMed rate limit from 3 to 10 requests per second.
NCBI_API_KEY=

# --- scheduling -------------------------------------------------------------
# Leave off and drive the pipeline from cron or an HTTP scheduler (recommended;
# see the README). Set to 1 only if the host offers no scheduler at all.
ENABLE_INTERNAL_SCHEDULER=0
DAILY_RUN_HOUR=6
